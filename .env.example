# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Stella talks to Claude through OpenRouter's OpenAI-compatible endpoint
# (https://openrouter.ai/api/v1), not the Anthropic API directly — this lets
# it run on an OpenRouter key (starts with sk-or-v1-...) rather than requiring
# a direct Anthropic key (sk-ant-...). Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. OpenRouter model slug. Defaults to anthropic/claude-opus-5.
# STELLA_MODEL=anthropic/claude-sonnet-5

# Optional. Thinking effort for every call: low / medium / high. Defaults to
# low, which keeps extraction calls from being truncated by reasoning tokens
# eating the max_tokens budget, and keeps cost down.
# STELLA_REASONING_EFFORT=low

# Optional. Set to 1 to append per-call traces to .stella_traces.jsonl
# STELLA_TRACE=1
